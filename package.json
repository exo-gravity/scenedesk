{
  "name": "drama-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:web": "npm run dev --workspace @drama/web",
    "setup:business": "node --env-file-if-exists=.env --import tsx scripts/setup-local-business.ts",
    "upgrade:business": "node --env-file=.env --env-file=.env.business --import tsx scripts/upgrade-local-business.ts",
    "dev:identity": "node --env-file=.env.business --import tsx scripts/dev-oidc.ts",
    "dev:business-api": "node --env-file=.env.business --env-file-if-exists=.env.media-api --import tsx scripts/dev-business-api.ts",
    "dev:business": "concurrently --kill-others --names identity,api,web \"npm run dev:identity\" \"npm run dev:business-api\" \"npm run dev:web\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "ui:check": "node --import tsx scripts/check-ui.ts",
    "build": "npm run typecheck && npm run build --workspace @drama/web",
    "contracts:generate": "openapi-typescript docs/implementation/openapi.json -o packages/contracts/src/generated.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test --config tests/e2e/playwright.config.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker:check": "node --env-file-if-exists=.env --import tsx apps/worker/src/check.ts",
    "mock:scenarios": "tsx scripts/mock-scenarios.ts",
    "check": "npm run contracts:check && npm run ui:check && npm run build && npm test",
    "contracts:check": "node scripts/check-generated.mjs",
    "setup:queue": "node --env-file=.env --env-file=.env.business --import tsx scripts/setup-local-queue.ts",
    "queue:check": "node --env-file=.env.business --env-file=.env.queue --import tsx scripts/check-queue.ts",
    "test:media:prepare": "node --import tsx scripts/prepare-media-tests.ts",
    "test:media": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/media/*.test.ts",
    "setup:media": "node --env-file=.env --env-file=.env.business --env-file=.env.queue --import tsx scripts/setup-local-media.ts",
    "dev:media-worker": "node --env-file=.env.media-worker --env-file=.env.queue --import tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/yauzl": "2.10.3",
    "concurrently": "10.0.5",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  }
}
