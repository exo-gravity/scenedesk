  await toggle.waitFor();
  if ((await toggle.getAttribute("aria-pressed")) !== "true") await toggle.click();
  await panel.getByRole("combobox", { name: "来源剧本", exact: true }).waitFor();
  if (!(await panel.getByRole("combobox", { name: "来源剧本", exact: true }).inputValue())) {
    await panel.getByRole("combobox", { name: "来源剧本", exact: true }).click();
    await page.getByRole("option", { name: "剧本第 1 版 · 当前", exact: true }).click();
  }
  await panel.getByRole("button", { name: "明确使用整篇", exact: true }).click();
  await panel.getByRole("textbox", { name: "分镜要求", exact: true }).fill("保留手工要求：先看门口，再核对桌上的钥匙。异步流程技术验收。");
