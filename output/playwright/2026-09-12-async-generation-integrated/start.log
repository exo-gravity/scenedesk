  await page.getByRole("option", { name: "异步 HTTP 技术夹具（无真实模型） · structured_text · 测试", exact: true }).click();
  await page.route(`**${base}/generation-plans`, async route => {
    if (route.request().method() !== "POST") return route.continue();
    planPosts++;
    const response = await route.fetch();
    if (response.status() !== 201) throw Error(`Plan failed ${response.status()}`);
    plan = await response.json(); await route.fulfill({ response });
  });
  await page.route(`**${base}/generation-jobs`, async route => {
    if (route.request().method() !== "POST") return route.continue();
    executePosts++;
    const response = await route.fetch();
    if (response.status() !== 202) throw Error(`Execution failed ${response.status()}`);
    job = await response.json(); await route.fulfill({ response });
  });
  try {
    await panel.getByRole("button", { name: "查看分镜分析计划", exact: true }).click();
    await panel.getByRole("button", { name: "确认执行测试计划", exact: true }).waitFor();
    if (plan.executionMode !== "test_fixture" || plan.status !== "ready") throw Error("Not a fixed fixture plan");
    await panel.getByRole("button", { name: "确认执行测试计划", exact: true }).click();
    await panel.locator('[aria-label="本次分镜任务"]').getByText("排队中", { exact: true }).waitFor();
    await page.evaluate(async () => { const r = await fetch("/__fixture/control", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "resume" }) }); if (!r.ok) throw Error("Fixture resume failed"); });
    await panel.getByText("模型已接收这次任务，正在等待处理。可以离开页面，稍后读取进度。", { exact: true }).waitFor({ timeout: 30000 });
    const external = await page.evaluate(async () => (await fetch("/__fixture/state")).json());
    if (planPosts !== 1 || executePosts !== 1 || external.jobs.length !== 1 || external.workerErrors.length || external.jobs[0].jobId !== job.id) throw Error("Original provider identity missing or duplicated");
    await page.screenshot({ path: "output/playwright/2026-09-12-async-generation-integrated/pending-1512.png", fullPage: true });
    return { status: "passed", actualApiDatabaseWorkerHttp: true, realModel: false, planId: plan.id, jobId: job.id, providerJobId: external.jobs[0].providerJobId, planPosts, executePosts, providerSubmitPosts: external.requests.filter(r => r.operation === "submit").length, fixedPrompt: plan.resolvedInput.prompt, pendingObserved: true };
  } finally { await page.unroute(`**${base}/generation-plans`); await page.unroute(`**${base}/generation-jobs`); }
}
)(page);
