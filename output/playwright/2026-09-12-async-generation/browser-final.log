  await composer.getByRole("button", { name: "生成视频", exact: true }).click();
  await video.getByText("取消请求已记录，尚未确认取消。原任务仍会继续核对。", { exact: true }).waitFor();
  ensure(await composer.getByRole("textbox", { name: "本次提示", exact: true }).inputValue() === "异步任务期间保留的手工原文。", "original input not retained");
  ensure(writes.filter(row => row.path.endsWith("/cancel")).length === 4, "scope switch repeated cancellation");
  ensure(
    writes.filter((row) => row.path === `${base}/generation-jobs`).length === 3,
    "unexpected execution",
  );
  ensure(errors.length === 0, "page errors: " + errors.join(","));
  return {
    mode: "production build with controlled HTTP transport; no real provider",
    passed: true,
    jobs: [...jobs.values()],
    cancelWrites,
    executions: 3,
    lateReplyScopeIsolation: true,
    queuedCancelThenNewPlan: true,
    planCount: plans.size,
    readCount: reads.length,
    pageErrors: errors,
  };
}
)(page);
