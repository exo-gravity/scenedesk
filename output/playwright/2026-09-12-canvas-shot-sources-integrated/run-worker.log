 const first=await (await page.request.get(`${f.origin}/__fixture/state`)).json();ensure(first.paused&&first.calls===0,'provider was submitted before explicit execution');
 await page.getByRole('button',{name:'移除节点',exact:true}).click();
 const saved=page.waitForResponse(r=>r.url().endsWith(`/canvases/${f.canvasId}`)&&r.request().method()==='PUT',{timeout:60000});await page.getByRole('button',{name:'保存画布',exact:true}).click();ensure((await saved).status()===200,'source deletion was not saved');
 let canvas=await (await page.request.get(`${path}/canvases/${f.canvasId}`)).json();ensure(!canvas.document.nodes.some(n=>n.id===f.nodeId),'source draft still exists');
