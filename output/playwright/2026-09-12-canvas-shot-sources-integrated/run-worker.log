 let job;const deadline=Date.now()+240000;
 do {job=await (await page.request.get(`${base}/generation-jobs/${jobId}`)).json();if(job.status==='succeeded')break;ensure(!['failed','archive_failed','reconciliation_required'].includes(job.status),`job failed ${JSON.stringify(job)}`);ensure(Date.now()<deadline,`waited for original job: ${job.status}`);await page.waitForTimeout(1000);} while(true);
 const state=await (await page.request.get(`${f.origin}/__fixture/state`)).json();ensure(state.calls===1&&state.errors.length===0&&state.queueErrors.length===0,'worker submission/error count differs');
 ensure(JSON.stringify(state.last.input.shotSources)===JSON.stringify(expected.plan.input.shotSources),'worker source order differs');ensure(JSON.stringify(state.last.resolvedInput)===JSON.stringify(expected.plan.resolvedInput),'worker fixed snapshot differs');
 ensure(job.mediaIds.length===1,'expected one archived image');const media=await (await page.request.get(`${base}/media/${job.mediaIds[0]}`)).json();ensure(media.status==='ready'&&media.sha256===f.expectedOutputSha256,'actual image archive/hash failed');
 await page.reload();const panel=page.getByRole('region',{name:'画布生成与结果',exact:true}),toggle=page.getByRole('button',{name:'画布生成与结果',exact:true});await toggle.waitFor();if(await toggle.getAttribute('aria-expanded')!=='true')await toggle.click();await panel.getByRole('combobox',{name:'画布生成任务历史',exact:true}).selectOption(expected.plan.id);await panel.getByRole('button',{name:'打开所选的固定图片任务',exact:true}).click();
 await panel.getByText('图片结果已归档',{exact:true}).waitFor();await panel.locator('summary').filter({hasText:'固定镜头来源（2 个）'}).click();await panel.locator('[aria-label="计划原镜头来源"]').getByText('旧要求：先看门口再看钥匙',{exact:true}).first().waitFor();
 return {job,media,worker:state,canvasBeforePlacement:canvas,sourceDeleted:true,historySnapshotRecovered:true,buttons:await panel.getByRole('button').allTextContents()};
